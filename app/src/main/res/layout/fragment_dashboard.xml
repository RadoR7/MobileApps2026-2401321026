<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="18dp">
        <TextView android:text="Your daily overview" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textStyle="bold"
            android:textAppearance="?attr/textAppearanceHeadlineMedium" />
        <TextView android:id="@+id/todayDate" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="6dp"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="18dp"
            app:cardCornerRadius="24dp" app:cardBackgroundColor="?attr/colorPrimaryContainer">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:padding="20dp" android:orientation="vertical">
                <TextView android:text="Today at a glance" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textStyle="bold"
                    android:textAppearance="?attr/textAppearanceTitleLarge" />
                <TextView android:id="@+id/headlineSummary" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:text="Log your first activity to see your progress." />
                <TextView android:id="@+id/dailyNet" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="10dp"
                    android:textStyle="bold" android:textAppearance="?attr/textAppearanceHeadlineSmall" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="14dp" app:cardCornerRadius="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:text="Food calories" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textStyle="bold" />
                <TextView android:id="@+id/foodSummary" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="7dp" />
                <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/foodProgress"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp" app:cardCornerRadius="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:text="Active minutes" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textStyle="bold" />
                <TextView android:id="@+id/workoutSummary" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="7dp" />
                <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/workoutProgress"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp" app:cardCornerRadius="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:text="Sleep" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textStyle="bold" />
                <TextView android:id="@+id/sleepSummary" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="7dp" />
                <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/sleepProgress"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp" app:cardCornerRadius="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:text="Water intake" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textStyle="bold" />
                <TextView android:id="@+id/waterSummary" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="7dp" />
                <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/waterProgress"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="8dp">
                    <com.google.android.material.button.MaterialButton android:id="@+id/addWater"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+ Water" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/waterHistory"
                        style="?attr/borderlessButtonStyle" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="History" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="18dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/shareDay"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="Share report" />
            <com.google.android.material.button.MaterialButton android:id="@+id/showQr"
                style="@style/Widget.Material3.Button.OutlinedButton" android:layout_marginStart="8dp"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="Show QR" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:layout_marginBottom="24dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:text="Personal estimates only. Calorie balance excludes basal metabolism; FitTrack is not medical advice." />
    </LinearLayout>
</ScrollView>
